{
  "name": "diesel-for-you-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Diesel for You — on-demand fuel delivery platform. Backend API (modular monolith).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "imports": {
    "#prisma": "./generated/prisma/client.ts"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "check": "npm run lint && npm run format:check && npm run prisma:validate",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "create:admin": "node scripts/create-admin.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "seed:superadmin": "node scripts/seed-superadmin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:operations": "node scripts/seed-operations.js",
    "seed:pricing": "node scripts/seed-pricing.js",
    "verify:driver": "node scripts/verify-driver-flow.mjs",
    "verify:customer": "node scripts/verify-customer-flow.mjs",
    "verify:onboarding": "node scripts/verify-driver-onboarding.mjs",
    "verify:fleet": "node scripts/verify-fleet-admin.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0"
  }
}
