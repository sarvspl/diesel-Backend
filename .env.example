# -----------------------------------------------------------------------------
# Diesel for You - backend environment
# -----------------------------------------------------------------------------
# Copy to .env and fill in real values:   cp .env.example .env
# .env is git-ignored and must never be committed.
#
# Every variable below is validated by Zod at startup (src/config/env.js).
# The server refuses to boot on invalid configuration.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=diesel-for-you-backend

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Create the database first, e.g.
#   createdb diesel_for_you
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diesel_for_you?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000

# --- Authentication ----------------------------------------------------------
# REQUIRED. Minimum 32 characters, and the two must differ from each other.
# Generate with:  openssl rand -base64 48
#             or: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# The values below are intentionally rejected by validation - replace them.
JWT_ACCESS_SECRET=replace_me_generate_a_real_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_generate_a_different_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m

# SLIDING refresh window - pushed out on every rotation, so an active user is
# never signed out mid-use.
JWT_REFRESH_EXPIRES_IN=30d

# ABSOLUTE session ceiling - fixed at login and never extended.
# Without it, rotation renews the sliding window forever and a session never
# dies, including one an attacker keeps alive with a stolen refresh token.
# Must be >= JWT_REFRESH_EXPIRES_IN (validated at startup).
SESSION_ABSOLUTE_LIFETIME=90d

# --- HTTP --------------------------------------------------------------------
# Comma-separated allowlist. "*" is rejected when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
# Maximum accepted request body size.
BODY_LIMIT=100kb
# Express "trust proxy". Keep false unless the app sits behind a load balancer
# or reverse proxy you control; otherwise client IPs (and therefore rate
# limiting) can be spoofed via X-Forwarded-For.
#   false | true | <number of hops> | loopback | <CIDR list>
TRUST_PROXY=false

# --- Password hashing --------------------------------------------------------
# Argon2id work factor. OWASP baseline: 19 MiB, 2 iterations, 1 lane.
# Raise ARGON2_MEMORY_COST_KIB until one hash takes roughly 100ms on your
# production hardware. Lower values are fine for local development and tests.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Authentication endpoints get a far stricter budget than the global limit.
# Keyed by IP + submitted identifier, so one office NAT cannot lock out
# everyone behind it. 10 attempts per 15 minutes is deliberately tight.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- OTP ---------------------------------------------------------------------
# Provider abstraction only in this phase - there is no OTP endpoint yet
# (it needs an otp_challenges table). `console` logs the code in development
# and REFUSES to run when NODE_ENV=production.
OTP_PROVIDER=console
OTP_LENGTH=6
OTP_TTL_SECONDS=300

# --- Observability -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Lifecycle ---------------------------------------------------------------
# Grace period for in-flight requests to finish during shutdown.
SHUTDOWN_TIMEOUT_MS=15000

# --- Pricing -----------------------------------------------------------------
# How long a quote holds its price (BR-604). A commercial trade-off, not a
# constant: too short and customers are re-quoted mid-checkout, too long and
# the platform is exposed when the daily rate revises around 06:00 IST.
QUOTE_TTL_SECONDS=900

# --- Testing -----------------------------------------------------------------
# Integration tests are SKIPPED unless this is set. Point it at a SEPARATE
# database - the suite creates and deletes rows, and pointing it at the
# development database will delete development data.
#
# Prepare it once with:
#   DATABASE_URL=<this value> npx prisma migrate deploy
#   DATABASE_URL=<this value> npm run prisma:seed
#
# If the password contains @ : / ? # or &, percent-encode it (@ becomes %40).
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/diesel_for_you_test?schema=public
